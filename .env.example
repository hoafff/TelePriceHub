# ==========================================
# CẤU HÌNH TELEPRICEHUB (TELEGRAM PRICE AGGREGATOR)
# ==========================================

# 1. Telegram MTProto Userbot (Duyệt bot nhà cung cấp)
# Lấy api_id và api_hash tại: https://my.telegram.org/apps
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789
TELEGRAM_SESSION_NAME=teleprice_userbot
# Tùy chọn: StringSession để chạy trên GitHub Actions / Headless không cần file .session
TELEGRAM_STRING_SESSION=

# 2. Telegram Query Bot (Bot tra cứu cá nhân)
# Lấy token từ @BotFather
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
# Telegram User ID của bạn (chỉ cho phép bạn dùng bot)
ALLOWED_USER_IDS=123456789

# 3. Gemini API (Tùy chọn - Free tier 15 RPM / 1M TPM)
# Lấy key tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 4. Danh sách Bot nhà cung cấp mục tiêu (phân cách bằng dấu phẩy)
SUPPLIER_BOTS=@supplier_bot_1,@supplier_bot_2

# 5. Tham số vận hành Crawler (Chống spam / FloodWait)
CRAWL_DELAY_MIN=1.5
CRAWL_DELAY_MAX=3.0
MAX_DEPTH=5
DB_PATH=teleprice.db
